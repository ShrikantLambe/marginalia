# Stack Auth — get from https://app.stack-auth.com after creating a project
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
STACK_SECRET_SERVER_KEY=

# Supabase — get from Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
# The SECRET key (sb_secret_…), NOT the publishable key. The server uses this to
# bypass RLS; a publishable key returns zero rows once RLS is enabled.
SUPABASE_SECRET_KEY=

# Gemini — get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tavily — web search for Discover; get a key from https://tavily.com
# Leave empty (or set SEARCH_PROVIDER=mock) to use the built-in mock provider
TAVILY_API_KEY=
SEARCH_PROVIDER=

# Cron — required for the daily clustering cron to authenticate on Vercel
CRON_SECRET=
